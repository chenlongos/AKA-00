# =============================================================================
# csrc — 交叉编译 Makefile（SG2002 / riscv64 musl 静态库）
#
# 用法:
#   make -f Makefile.cross                        # 工具链在 PATH 里（riscv64-unknown-linux-musl-*）
#   make -f Makefile.cross AKA_TOOLCHAIN_DIR=/path/to/toolchain/
#   make -f Makefile.cross CXX=/path/to/riscv64-unknown-linux-musl-g++
#
# 工具链位置优先由 CXX/AR 指定；未指定时取 AKA_TOOLCHAIN_DIR/bin/ 下的交叉工具链；
# 两者都未设则回退为裸命令名（走 PATH）。顶层 cpp/Makefile 会统一传入。
#
# JPEG_DIR 指向 libjpeg 安装前缀（含 include/ 与 lib/，由 scripts/build-libjpeg.sh 生成）
# =============================================================================

# 带屏 / 不带屏两个变体：
#   WITH_SCREEN=1（默认）→ build-cross/libcsrc.a          含屏显示（screen_display）
#   WITH_SCREEN=0         → build-cross-noscreen/libcsrc.a 裁掉显示栈（不带屏版本）
WITH_SCREEN ?= 1
ifeq ($(WITH_SCREEN),1)
SCREEN_SUFFIX :=
SCREEN_DEF    := -DAKA_WITH_SCREEN=1
else
SCREEN_SUFFIX := -noscreen
SCREEN_DEF    := -DAKA_WITH_SCREEN=0
endif

# ── TPU 推理（cviruntime）──
#   WITH_TPU=1（默认）→ 编入 YoloDetector（真实现），需要板子的 TPU SDK
#   WITH_TPU=0         → 只留桩（与开发机一致）
# SDK 不在仓库里（也不 vendor 头文件），靠这个变量指过去；换机器只改这一个路径。
# 无默认路径：WITH_TPU=1 且未指定 TPU_SDK_DIR 时直接报错（顶层 make 会显式传下来）。
WITH_TPU    ?= 1
ifeq ($(WITH_TPU),1)
ifeq ($(strip $(TPU_SDK_DIR)),)
$(error TPU_SDK_DIR 未指定（WITH_TPU=1 需要 cvitek TPU SDK）—— 传 TPU_SDK_DIR=/path/to/cvitek_tpu_sdk，或 WITH_TPU=0 关掉 TPU 推理)
endif
endif
ifeq ($(WITH_TPU),1)
TPU_DEF := -DAKA_WITH_TPU=1
TPU_INC := -I$(TPU_SDK_DIR)/include
else
TPU_DEF := -DAKA_WITH_TPU=0
TPU_INC :=
endif

# 工具链：命令行 CXX/AR > 环境变量 AKA_TOOLCHAIN_DIR/bin/ > PATH 里的裸命令名
# （写死的默认路径已去掉，由用户自行指定。CXX/AR/CC 是 make 内置变量，
#   origin 为 default（内置 host 值）或 environment（登录 shell 导出的 g++ 等）时
#   一律重新赋值，免得 host 工具链污染交叉编译；命令行传值优先且不受影响）
CROSS_DIR  := $(if $(strip $(AKA_TOOLCHAIN_DIR)),$(AKA_TOOLCHAIN_DIR)bin/,)
CROSS_NAME := riscv64-unknown-linux-musl-
ifeq ($(filter command line file,$(origin CXX)),)
CXX := $(CROSS_DIR)$(CROSS_NAME)g++
endif
ifeq ($(filter command line file,$(origin AR)),)
AR := $(CROSS_DIR)$(CROSS_NAME)ar
endif
override CC := $(CROSS_DIR)$(CROSS_NAME)gcc
JPEG_DIR ?= ../third_party/jpeg
# mbedtls：https_client.cpp（客户端 TLS）要头文件。库由 capp 链接（-lmbedtls ...），
# 静态库里留未定义符号没问题 —— 这里只需要 include 路径。
MBEDTLS_DIR ?= ../third_party/mbedtls
CXXFLAGS := -std=c++17 -O3 -Wall -Wextra -mcpu=c906fdv -MMD -MP -mabi=lp64d \
            $(SCREEN_DEF) $(TPU_DEF) -Iinclude $(TPU_INC) -I$(JPEG_DIR)/include \
            -I$(MBEDTLS_DIR)/include
ARFLAGS   = rcs

OBJDIR   := build-cross$(SCREEN_SUFFIX)
SRCS := $(wildcard src/*.cpp src/camera/*.cpp src/display/*.cpp)
OBJS := $(SRCS:src/%.cpp=$(OBJDIR)/%.o)
LIB  := $(OBJDIR)/libcsrc.a
DEPS := $(OBJS:.o=.d)
-include $(DEPS)

.DEFAULT_GOAL := all
.PHONY: all tools clean

all: $(LIB)

# 直测工具（板上排查硬件链路用）
TOOLS := $(wildcard tools/*.cpp)
TOOL_BINS := $(TOOLS:tools/%.cpp=$(OBJDIR)/%)

tools: $(TOOL_BINS)

# 工具链接 libjpeg：用到 csrc::Camera（jpeg 解码/编码）的工具会拉进 camera.o，
# 不显式链接会报 undefined reference to jpeg_*
$(OBJDIR)/%: tools/%.cpp $(LIB)
	$(CXX) $(CXXFLAGS) -static -o $@ $< $(LIB) $(JPEG_DIR)/lib/libjpeg.a -lpthread

$(OBJDIR):
	mkdir -p $(OBJDIR)

# 切换 WITH_TPU 时必须强制重编：make 只看 mtime，不认编译选项 —— 不加这层，
# 从 WITH_TPU=0 切到 1 会被告知 "Nothing to be done"，拿到的是上次的旧产物。
TPU_STAMP := $(OBJDIR)/.tpu-$(WITH_TPU)
$(TPU_STAMP):
	@mkdir -p $(OBJDIR)
	@rm -f $(OBJDIR)/.tpu-*
	@touch $@

$(OBJDIR)/%.o: src/%.cpp $(TPU_STAMP) | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(LIB): $(OBJS)
	$(AR) $(ARFLAGS) $@ $(OBJS)
	@echo "  ✓ libcsrc.a$(SCREEN_SUFFIX) (riscv64$(if $(SCREEN_SUFFIX), 不带屏, 带屏)) built"

clean:
	rm -rf build-cross build-cross-noscreen
