# =============================================================================
# csrc — 交叉编译 Makefile（SG2002 / riscv64 musl 静态库）
#
# 用法:
#   make -f Makefile.cross                        # 用默认工具链
#   make -f Makefile.cross CXX=/path/to/riscv64-unknown-linux-musl-g++
#
# JPEG_DIR 指向 libjpeg 安装前缀（含 include/ 与 lib/，由 scripts/build-libjpeg.sh 生成）
# =============================================================================

# 带屏 / 不带屏两个变体：
#   WITH_SCREEN=1（默认）→ build-cross/libcsrc.a          含屏显示（screen_display）
#   WITH_SCREEN=0         → build-cross-noscreen/libcsrc.a 裁掉显示栈（不带屏版本）
WITH_SCREEN ?= 1
ifeq ($(WITH_SCREEN),1)
SCREEN_SUFFIX :=
SCREEN_DEF    := -DAKA_WITH_SCREEN=1
else
SCREEN_SUFFIX := -noscreen
SCREEN_DEF    := -DAKA_WITH_SCREEN=0
endif

# ── TPU 推理（cviruntime）──
#   WITH_TPU=1（默认）→ 编入 YoloDetector（真实现），需要板子的 TPU SDK
#   WITH_TPU=0         → 只留桩（与开发机一致）
# SDK 不在仓库里（也不 vendor 头文件），靠这个变量指过去；换机器只改这一个路径。
WITH_TPU    ?= 1
TPU_SDK_DIR ?= /home/junbo_dai/cvitek_tpu_sdk
ifeq ($(WITH_TPU),1)
TPU_DEF := -DAKA_WITH_TPU=1
TPU_INC := -I$(TPU_SDK_DIR)/include
else
TPU_DEF := -DAKA_WITH_TPU=0
TPU_INC :=
endif

# 注意用 := 覆盖环境变量（orb 登录 shell 常导出 CXX=g++ 之类，会污染交叉编译）
CXX      := /home/junbo_dai/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-g++
AR       := /home/junbo_dai/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-ar
JPEG_DIR ?= ../third_party/jpeg
CXXFLAGS := -std=c++17 -O3 -Wall -Wextra -mcpu=c906fdv -MMD -MP -mabi=lp64d \
            $(SCREEN_DEF) $(TPU_DEF) -Iinclude $(TPU_INC) -I$(JPEG_DIR)/include
ARFLAGS   = rcs

OBJDIR   := build-cross$(SCREEN_SUFFIX)
SRCS := $(wildcard src/*.cpp src/camera/*.cpp src/display/*.cpp)
OBJS := $(SRCS:src/%.cpp=$(OBJDIR)/%.o)
LIB  := $(OBJDIR)/libcsrc.a
DEPS := $(OBJS:.o=.d)
-include $(DEPS)

.DEFAULT_GOAL := all
.PHONY: all tools clean

all: $(LIB)

# 直测工具（板上排查硬件链路用）
TOOLS := $(wildcard tools/*.cpp)
TOOL_BINS := $(TOOLS:tools/%.cpp=$(OBJDIR)/%)

tools: $(TOOL_BINS)

# 工具链接 libjpeg：用到 csrc::Camera（jpeg 解码/编码）的工具会拉进 camera.o，
# 不显式链接会报 undefined reference to jpeg_*
$(OBJDIR)/%: tools/%.cpp $(LIB)
	$(CXX) $(CXXFLAGS) -static -o $@ $< $(LIB) $(JPEG_DIR)/lib/libjpeg.a -lpthread

$(OBJDIR):
	mkdir -p $(OBJDIR)

# 切换 WITH_TPU 时必须强制重编：make 只看 mtime，不认编译选项 —— 不加这层，
# 从 WITH_TPU=0 切到 1 会被告知 "Nothing to be done"，拿到的是上次的旧产物。
TPU_STAMP := $(OBJDIR)/.tpu-$(WITH_TPU)
$(TPU_STAMP):
	@mkdir -p $(OBJDIR)
	@rm -f $(OBJDIR)/.tpu-*
	@touch $@

$(OBJDIR)/%.o: src/%.cpp $(TPU_STAMP) | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(LIB): $(OBJS)
	$(AR) $(ARFLAGS) $@ $(OBJS)
	@echo "  ✓ libcsrc.a$(SCREEN_SUFFIX) (riscv64$(if $(SCREEN_SUFFIX), 不带屏, 带屏)) built"

clean:
	rm -rf build-cross build-cross-noscreen
