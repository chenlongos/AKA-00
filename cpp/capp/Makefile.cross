# =============================================================================
# capp — 交叉编译 Makefile（SG2002 / riscv64 musl 静态）
#
# 用法:
#   make -f Makefile.cross                          # 默认工具链
#   make -f Makefile.cross CXX=/path/to/riscv64-unknown-linux-musl-g++ \
#                          JPEG_DIR=/path/to/libjpeg
#
# JPEG_DIR 指向 libjpeg 安装前缀（含 include/ 与 lib/）。
# 默认 third_party/jpeg —— 先跑一次 ../scripts/build-libjpeg.sh 生成
# （riscv64 musl 交叉编译 libjpeg）；也可以指向自己的交叉 libjpeg。
# =============================================================================

# 注意用 := 覆盖环境变量（orb 登录 shell 常导出 CXX=g++ 之类，会污染交叉编译）
CXX      := /home/junbo_dai/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-g++
CSRC     := ../csrc
JPEG_DIR ?= ../third_party/jpeg
TARGET   := bin/aka-capp

CXXFLAGS := -std=c++17 -O3 -Wall -Wextra -mcpu=c906fdv -MMD -MP -mabi=lp64d \
            -Iinclude -I$(CSRC)/include -I$(JPEG_DIR)/include
LDFLAGS  := -static -L$(JPEG_DIR)/lib

SRCS := $(wildcard src/*.cpp)
OBJS := $(SRCS:src/%.cpp=build-cross/%.o)
DEPS := $(OBJS:.o=.d)
-include $(DEPS)

.DEFAULT_GOAL := all
.PHONY: all clean

all: $(TARGET)

build-cross:
	mkdir -p build-cross bin

build-cross/%.o: src/%.cpp | build-cross
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(CSRC)/build-cross/libcsrc.a:
	$(MAKE) -f Makefile.cross -C $(CSRC)

$(TARGET): $(OBJS) $(CSRC)/build-cross/libcsrc.a | bin
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(CSRC)/build-cross/libcsrc.a \
	    $(LDFLAGS) -ljpeg -lpthread
	@echo "  ✓ aka-capp (riscv64 static) built"

clean:
	rm -rf build-cross bin
